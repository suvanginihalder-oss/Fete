{
  "version": 2,
  "functions": {
    "api/generate-plan.ts": {
      "maxDuration": 30
    },
    "api/chat.ts": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}